<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lekiwi_base_control</name>
  <version>0.1.0</version>
  <description>cmd_vel executor for the LeKiwi Kiwi-drive base inside Isaac Sim.</description>
  <maintainer email="vpraise@example.com">vpraise</maintainer>
  <license>MIT</license>

  <buildtool_depend>setuptools</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
